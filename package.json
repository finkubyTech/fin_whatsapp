{
  "name": "fin_whatsapp",
  "version": "0.1.0",
  "private": true,
  "description": "Finkuby WhatsApp gateway: linked numbers (Baileys), send and receive, chats, contacts, groups, labels, auto-replies, opt-outs, scheduled messages, broadcasts, webhooks",
  "main": "./src/app.ts",
  "engines": {
    "node": ">=24"
  },
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node ./build/src/app.js",
    "local": "nodemon",
    "lint": "eslint .",
    "fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"config/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --coverageReporters=text-summary"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cors": "^2.8.6",
    "cron-parser": "^5.6.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "http-errors": "^2.0.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.2.10",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "pg": "^8.20.0",
    "pino": "^10.1.0",
    "qrcode": "^1.5.4",
    "undici": "^7.16.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.4",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/tests"
    ],
    "testRegex": ".*.spec.ts$",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.ts"
    ]
  }
}
