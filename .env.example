# fin_whatsapp — copy to .env (gitignored). On the servers these come from
# /opt/apps/<env>/.env, shared with the other fin_ services.

PORT=5109
ENVIRONMENT=LOCAL                 # LOCAL | DEVELOPMENT | STAGING | PRODUCTION
LOGGER_LEVEL=debug

# ---- Postgres (fin_migrations owns the wa_* tables) ----
DB_HOST=localhost
DB_PORT=5432
DB_SCHEMA=loan_management         # the database name, as in every fin_ service
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# ---- Shared with the other fin_ services ----
# Staff tokens are verified with fin_crm_app's public key (PEM on one line, \n escapes).
PUBLIC_KEY=
# 32 characters; the same value as every service (payload encryption).
RESPONSE_ENCRYPTION_KEY=
# Other fin_ services call with x-internal-key (e.g. fin_notifications sending applicant updates).
INTERNAL_API_KEY=
CORS_ORIGINS=http://localhost:3001

# ---- WhatsApp ----
# 64 hex characters (openssl rand -hex 32). Encrypts the stored WhatsApp logins
# and webhook secrets. Set it once per environment and never change it: a new
# key means linking every number again by QR.
WHATSAPP_ENCRYPTION_KEY=
# Received media (a Docker volume on the servers).
WHATSAPP_MEDIA_DIR=data/media
WHATSAPP_MAX_UPLOAD_MB=16
# Ask WhatsApp for the whole chat history when a number is linked (heavy on a busy number).
WHATSAPP_SYNC_FULL_HISTORY=false
# Reconnect the numbers that were connected when the service last stopped.
WHATSAPP_AUTOSTART=true
# Webhook hosts allowed even though they are internal (comma-separated), e.g.
# a fin_ service on the Docker network: gateway,fin_rm_inbox. Everything else must be https and public.
WHATSAPP_WEBHOOK_ALLOWED_HOSTS=
# Baileys' own log level (error keeps it quiet; debug for connection problems).
BAILEYS_LOG_LEVEL=error
